<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=1280, initial-scale=1, maximum-scale=1, viewport-fit=cover">
  <title>ぽこあポケモンドット絵メーカー</title>
  <link rel="stylesheet" href="/static/css/style.css">
</head>
<body>
  <main class="layout">
    <header class="page-title-wrap" aria-label="ページタイトル">
      <p class="page-title">ぽこあポケモンドット絵メーカー</p>
    </header>
    {{ template "parts/error" . }}
    <section class="panel form-panel form-panel-full">
      <h1>入力フォーム</h1>
      {{ template "parts/select" .DotSizeSelect }}
      {{ template "parts/image-dnd" . }}
    </section>

    <section class="content-grid">
      <section class="panel block-info-panel">
        {{ template "parts/block-info" . }}
      </section>

      <section class="panel preview-panel">
        {{ template "parts/output-image" . }}
      </section>
    </section>
  </main>
</body>
</html>